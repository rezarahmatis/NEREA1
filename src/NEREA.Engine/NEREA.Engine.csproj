<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NEREA.Engine</RootNamespace>
    <AssemblyName>NEREA.Engine</AssemblyName>
    <Description>NEREA realtime engine: Direct3D 12 renderer, HLSL shaders and aquatic simulation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEREA.Core\NEREA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- HLSL sources are compiled at engine startup via D3DCompile (d3dcompiler_47). -->
    <EmbeddedResource Include="Shaders\**\*.hlsl" />
  </ItemGroup>

</Project>
