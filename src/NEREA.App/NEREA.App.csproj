<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NEREA.App</RootNamespace>
    <AssemblyName>NEREA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\NEREA.ico</ApplicationIcon>
    <WindowsSdkPackageVersion>10.0.19041.56</WindowsSdkPackageVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NEREA defines its own Main in Program.cs (startup logging + fatal error
         dialog). This define removes the XAML compiler's generated Main. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- NEREA product metadata -->
    <AssemblyTitle>NEREA</AssemblyTitle>
    <Product>NEREA</Product>
    <Company>NEREA</Company>
    <Description>Premium Native Windows Music Player and Living Aquatic Worlds. Let the music create the world.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Copyright>Copyright (c) NEREA contributors. MIT licensed.</Copyright>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Repository root (this csproj lives at src\NEREA.App\). -->
  <PropertyGroup>
    <NEREARepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</NEREARepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEREA.Core\NEREA.Core.csproj" />
    <ProjectReference Include="..\NEREA.Audio\NEREA.Audio.csproj" />
    <ProjectReference Include="..\NEREA.Engine\NEREA.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 1.8.260921001: fixes the 2026 XamlCompiler MSB3073 failure class
         (microsoft-ui-xaml#11183, fix merged 2026-08-08). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- 10.0.26100.4654: minimum required by WindowsAppSDK 1.8 (fixes NU1605 downgrade error). -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\NEREA.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\nerea-symbol-white.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- CI-only post-publish verification. Runs on GitHub Actions (where
       GITHUB_ACTIONS=true) right after Publish, so a publish output that
       cannot start fails the build instead of reaching the user. -->
  <Target Name="NEREAVerifyRuntimeFiles" AfterTargets="Publish" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PropertyGroup>
      <NEREAPublishExe>$([System.IO.Path]::Combine('$(PublishDir)', 'NEREA.exe'))</NEREAPublishExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(NEREAPublishExe)')" Text="NEREA.exe missing from publish output: $(NEREAPublishExe)" />
    <!-- Files that must sit next to NEREA.exe or the process dies before any
         managed diagnostics can run (the silent "installed but won't run"). -->
    <Exec Command="pwsh -NoProfile -Command &quot;$req = 'Microsoft.ui.xaml.dll','Microsoft.WindowsAppRuntime.Bootstrap.dll','Microsoft.WindowsAppRuntime.dll','coreclr.dll','clrjit.dll','hostfxr.dll','NEREA.dll'; $miss = @($req | Where-Object { -not (Test-Path (Join-Path '$(PublishDir)' $_)) }); if ($miss.Count -gt 0) { Write-Host ('::error::Missing required runtime files: ' + ($miss -join ', ')); exit 1 } else { Write-Host 'All required runtime files present next to NEREA.exe.' }&quot;" />
    <Message Importance="high" Text="NEREA publish output (top-level files):" />
    <Exec Command="pwsh -NoProfile -Command &quot;Get-ChildItem -LiteralPath '$(PublishDir)' -File | Sort-Object Name | ForEach-Object { Write-Host ('  {0}  {1:N0} bytes' -f $_.Name, $_.Length) }&quot;" />
    <Exec Command="pwsh -NoProfile -Command &quot;$pri = @(Get-ChildItem -LiteralPath '$(PublishDir)' -Filter '*.pri' -Recurse); if ($pri.Count -gt 0) { Write-Host ('Resource indexes: ' + (($pri | ForEach-Object { $_.Name }) -join ', ')) } else { Write-Host '::warning::No .pri resource index found in publish output - XAML resources may be missing.' }&quot;" />
    <Copy SourceFiles="$(NEREARepoRoot).github\NEREA-portable-readme.txt" DestinationFiles="$(PublishDir)README.txt" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied Persian README.txt into the publish output." />
  </Target>

  <!-- Launch the published exe on the CI runner. If NEREA cannot start, this
       fails the build with the crash log + event log output instead of
       shipping a broken installer/zip to the user. -->
  <Target Name="NEREASmokeTestPublishedApp" AfterTargets="NEREAVerifyRuntimeFiles" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(NEREARepoRoot).github\scripts\smoke-test-app.ps1&quot; -ExePath &quot;$(NEREAPublishExe)&quot; -WaitSeconds 15" LogStandardErrorsAsErrors="true" />
  </Target>

</Project>
