<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NEREA.App</RootNamespace>
    <AssemblyName>NEREA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\NEREA.ico</ApplicationIcon>
    <WindowsSdkPackageVersion>10.0.19041.56</WindowsSdkPackageVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NEREA product metadata -->
    <AssemblyTitle>NEREA</AssemblyTitle>
    <Product>NEREA</Product>
    <Company>NEREA</Company>
    <Description>Premium Native Windows Music Player and Living Aquatic Worlds. Let the music create the world.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Copyright>Copyright (c) NEREA contributors. MIT licensed.</Copyright>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEREA.Core\NEREA.Core.csproj" />
    <ProjectReference Include="..\NEREA.Audio\NEREA.Audio.csproj" />
    <ProjectReference Include="..\NEREA.Engine\NEREA.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 1.8.260921001: fixes the 2026 XamlCompiler MSB3073 failure class
         (microsoft-ui-xaml#11183, fix merged 2026-08-08). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- 10.0.26100.4654: minimum required by WindowsAppSDK 1.8 (fixes NU1605 downgrade error). -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\NEREA.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\nerea-symbol-white.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
