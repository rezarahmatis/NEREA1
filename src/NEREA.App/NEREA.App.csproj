<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NEREA.App</RootNamespace>
    <AssemblyName>NEREA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\NEREA.ico</ApplicationIcon>
    <WindowsSdkPackageVersion>10.0.19041.56</WindowsSdkPackageVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NEREA defines its own Main in Program.cs (startup logging + fatal error
         dialog). This define removes the XAML compiler's generated Main. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- NEREA product metadata -->
    <AssemblyTitle>NEREA</AssemblyTitle>
    <Product>NEREA</Product>
    <Company>NEREA</Company>
    <Description>Premium Native Windows Music Player and Living Aquatic Worlds. Let the music create the world.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Copyright>Copyright (c) NEREA contributors. MIT licensed.</Copyright>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Repository root (this csproj lives at src\NEREA.App\). -->
  <PropertyGroup>
    <NEREARepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</NEREARepoRoot>
    <NEREALogsDir>$(NEREARepoRoot)logs</NEREALogsDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEREA.Core\NEREA.Core.csproj" />
    <ProjectReference Include="..\NEREA.Audio\NEREA.Audio.csproj" />
    <ProjectReference Include="..\NEREA.Engine\NEREA.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 1.8.260921001: fixes the 2026 XamlCompiler MSB3073 failure class
         (microsoft-ui-xaml#11183, fix merged 2026-08-08). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- 10.0.26100.4654: minimum required by WindowsAppSDK 1.8 (fixes NU1605 downgrade error). -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\NEREA.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\nerea-symbol-white.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- CI-only post-publish verification. Runs on GitHub Actions (where
       GITHUB_ACTIONS=true) right after Publish, so a publish output that
       cannot start fails the build instead of reaching the user. All logic
       lives in .github/scripts/*.ps1 because inline pwsh -Command payloads
       get their outer quotes stripped by cmd.exe (MSBuild Exec runs through
       cmd.exe /c "..."), turning the one-liners into parse errors.
       OnError runs NEREAPrintStartupDiagnostics as a FRESH pwsh process
       (new pipe pair, app already killed) whose output reliably reaches the
       CI log - the failing script's own late output was swallowed in runs
       26/27. -->
  <Target Name="NEREAVerifyRuntimeFiles" AfterTargets="Publish" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PropertyGroup>
      <NEREAPublishExe>$([System.IO.Path]::Combine('$(PublishDir)', 'NEREA.exe'))</NEREAPublishExe>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(NEREARepoRoot).github\scripts\verify-publish-output.ps1&quot; -PublishExe &quot;$(NEREAPublishExe)&quot;" />
    <OnError ExecuteTargets="NEREAPrintStartupDiagnostics" />
  </Target>

  <!-- Launch the published exe on the CI runner. If NEREA cannot start, this
       fails the build with a distinct exit code (10 exited / 20 fatal
       diagnostics / 30 no startup marker) instead of shipping a broken
       installer/zip to the user. The verdict + crash-log tail are written to
       $(NEREALogsDir)\nerea-smoke-result.txt (files cannot lose bytes like a
       corrupted console pipe can) and re-printed by the OnError target. -->
  <Target Name="NEREASmokeTestPublishedApp" AfterTargets="NEREAVerifyRuntimeFiles" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(NEREARepoRoot).github\scripts\smoke-test-app.ps1&quot; -ExePath &quot;$(NEREAPublishExe)&quot; -WaitSeconds 15 -DiagDir &quot;$(NEREALogsDir)&quot;" />
    <OnError ExecuteTargets="NEREAPrintStartupDiagnostics" />
  </Target>

  <!-- Failure diagnostics. Invoked ONLY through <OnError> above, after the
       failing script exited and the app process was killed: a fresh pwsh
       with fresh console handles re-prints the verdict file and the crash
       log, emits ::notice:: annotations and compiler-style NEREA0001 lines
       (the runner parses those into check-run annotations too). It exits 0
       so diagnosis never masks the original failure. -->
  <Target Name="NEREAPrintStartupDiagnostics">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(NEREARepoRoot).github\scripts\diagnose-startup-failure.ps1&quot; -DiagDir &quot;$(NEREALogsDir)&quot;" />
  </Target>

</Project>
