<UserControl
    x:Class="NEREA.App.Views.AquariumPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="PanelRoot"
            Width="540"
            Background="{ThemeResource NereaAcrylicBrush}"
            BorderBrush="#267FC4C9" BorderThickness="1,0,0,0"
            CornerRadius="18,0,0,18">
        <Grid Padding="26,20,26,16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="AQUARIUM" Style="{ThemeResource NereaPanelHeaderText}" />
                <Button Style="{ThemeResource NereaGhostButton}" HorizontalAlignment="Right"
                        Click="Close_Click" ToolTipService.ToolTip="Close">
                    <Path Stroke="#E8EFF2" StrokeThickness="1.6" Stretch="None"
                          Data="M 5,5 L 15,15 M 15,5 L 5,15" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">

                    <TextBlock Text="SAVED AQUARIUMS" Style="{ThemeResource NereaSectionHeader}" />
                    <ListView x:Name="PresetsList" ItemsSource="{Binding Presets, Mode=OneWay}"
                              SelectionMode="Single"
                              IsDoubleTapEnabled="True" IsRightTapEnabled="True"
                              DoubleTapped="Preset_DoubleTapped"
                              RightTapped="Preset_RightTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8EFF2"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{ThemeResource NereaGhostButton}" Click="SavePreset_Click"
                                BorderBrush="#337FC4C9" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="Save current" FontSize="13" Foreground="#E8EFF2" />
                        </Button>
                        <Button Style="{ThemeResource NereaGhostButton}" Click="ApplyFirstPreset_Click"
                                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10"
                                ToolTipService.ToolTip="Apply the selected preset">
                            <TextBlock Text="Apply selected" FontSize="13" Foreground="#E8EFF2" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="WORLD" Style="{ThemeResource NereaSectionHeader}" />
                    <ComboBox x:Name="CategoryCombo" SelectedIndex="0" CornerRadius="8" MinWidth="200"
                              SelectionChanged="Category_SelectionChanged">
                        <ComboBoxItem Content="All worlds" />
                        <ComboBoxItem Content="Freshwater" />
                        <ComboBoxItem Content="Ocean" />
                        <ComboBoxItem Content="Exotic" />
                    </ComboBox>
                    <ListView x:Name="WorldsList" SelectionMode="Single"
                              ItemsSource="{Binding FilteredWorlds, Mode=OneWay}"
                              SelectionChanged="World_SelectionChanged" Margin="0,6,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="30" Height="30" CornerRadius="15">
                                        <Rectangle Fill="{Binding WaterShallow, Converter={StaticResource HexBrush}, Mode=OneWay}" RadiusX="15" RadiusY="15" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8EFF2" />
                                        <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#8FA0A8" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="POPULATION" Style="{ThemeResource NereaSectionHeader}" />
                    <ListView ItemsSource="{Binding Species, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="44" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8EFF2" />
                                        <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#8FA0A8" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{ThemeResource NereaGhostButton}" Padding="4"
                                            Click="DecrementSpecies_Click"
                                            ToolTipService.ToolTip="Fewer">
                                        <Path Stroke="#E8EFF2" StrokeThickness="1.6" Stretch="None"
                                              Data="M 4,8 H 12" />
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="14"
                                               Foreground="#E8EFF2" VerticalAlignment="Center"
                                               MinWidth="26" TextAlignment="Center" />
                                    <Button Grid.Column="3" Style="{ThemeResource NereaGhostButton}" Padding="4"
                                            Click="IncrementSpecies_Click"
                                            ToolTipService.ToolTip="More">
                                        <Path Stroke="#E8EFF2" StrokeThickness="1.6" Stretch="None"
                                              Data="M 8,4 V 12 M 4,8 H 12" />
                                    </Button>
                                    <Button Grid.Column="4" Style="{ThemeResource NereaGhostButton}" Padding="4"
                                            Click="RemoveSpecies_Click" ToolTipService.ToolTip="Remove species">
                                        <Path Stroke="#8FA0A8" StrokeThickness="1.4" Stretch="None"
                                              Data="M 5,5 L 11,11 M 11,5 L 5,11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <ComboBox x:Name="AddSpeciesCombo" MinWidth="220" CornerRadius="8"
                                  ItemsSource="{Binding AddableSpecies, Mode=OneWay}"
                                  DisplayMemberPath="Name" />
                        <Button Style="{ThemeResource NereaGhostButton}" Click="AddSpecies_Click"
                                BorderBrush="#337FC4C9" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="Add species" FontSize="13" Foreground="#E8EFF2" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="ATMOSPHERE" Style="{ThemeResource NereaSectionHeader}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CalmButton" Style="{ThemeResource NereaGhostButton}" Click="Atmosphere_Click" Tag="0"
                                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="Calm" FontSize="13" Foreground="#E8EFF2" />
                        </Button>
                        <Button x:Name="BalancedButton" Style="{ThemeResource NereaGhostButton}" Click="Atmosphere_Click" Tag="1"
                                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="Balanced" FontSize="13" Foreground="#E8EFF2" />
                        </Button>
                        <Button x:Name="VividButton" Style="{ThemeResource NereaGhostButton}" Click="Atmosphere_Click" Tag="2"
                                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="Vivid" FontSize="13" Foreground="#E8EFF2" />
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
