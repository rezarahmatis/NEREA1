<UserControl
    x:Class="NEREA.App.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="PanelRoot"
            Width="600"
            Background="{ThemeResource NereaAcrylicBrush}"
            BorderBrush="#267FC4C9" BorderThickness="1,0,0,0"
            CornerRadius="18,0,0,18">
        <Grid Padding="26,20,26,16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="SETTINGS" Style="{ThemeResource NereaPanelHeaderText}" />
                <Button Style="{ThemeResource NereaGhostButton}" HorizontalAlignment="Right"
                        Click="Close_Click" ToolTipService.ToolTip="Close">
                    <Path Stroke="#E8EFF2" StrokeThickness="1.6" Stretch="None"
                          Data="M 5,5 L 15,15 M 15,5 L 5,15" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">

                    <TextBlock Text="AUDIO" Style="{ThemeResource NereaSectionHeader}" />
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Output device" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8"
                                  ItemsSource="{Binding OutputDevices, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Loudness match" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding NormalizeLoudness, Mode=TwoWay}"
                                      OnContent="" OffContent="" Margin="0,-6,0,0" />
                    </Grid>

                    <TextBlock Text="VISUAL" Style="{ThemeResource NereaSectionHeader}" />
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Quality" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8"
                                  SelectedIndex="{Binding QualityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Battery" />
                            <ComboBoxItem Content="Performance" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="High" />
                            <ComboBoxItem Content="Ultra" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Frame limit" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8"
                                  SelectedIndex="{Binding FpsIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Match display" />
                            <ComboBoxItem Content="120 FPS" />
                            <ComboBoxItem Content="60 FPS" />
                            <ComboBoxItem Content="30 FPS" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Particles" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="2" StepFrequency="0.05"
                                Value="{Binding ParticleDensity, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fish population" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.1" Maximum="2" StepFrequency="0.05"
                                Value="{Binding FishPopulation, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Water quality" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="1" Maximum="4" StepFrequency="1"
                                Value="{Binding WaterQuality, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="26" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Light shafts" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding Reflections, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Shadows" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding Shadows, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="INTERACTION" Style="{ThemeResource NereaSectionHeader}" />
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mouse sensitivity" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.2" Maximum="2.5" StepFrequency="0.05"
                                Value="{Binding MouseSensitivity, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ripple strength" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="2" StepFrequency="0.05"
                                Value="{Binding RippleStrength, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fish reaction" FontSize="13"
                                   Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="2" StepFrequency="0.05"
                                Value="{Binding FishReaction, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="PERFORMANCE" Style="{ThemeResource NereaSectionHeader}" />
                    <StackPanel Orientation="Horizontal" Spacing="26">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Adaptive quality" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding AdaptiveQuality, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Battery saver" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding BatteryOptimization, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <TextBlock Text="Pause rendering when minimized" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                        <ToggleSwitch IsOn="{Binding PauseWhenMinimized, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                    </StackPanel>

                    <TextBlock Text="APPLICATION" Style="{ThemeResource NereaSectionHeader}" />
                    <StackPanel Orientation="Horizontal" Spacing="26">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Minimize to tray" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding MinimizeToTray, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Start with Windows" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="26" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Theme" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ComboBox CornerRadius="8" MinWidth="110"
                                      SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Light" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Reduced motion" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding ReducedMotion, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Solid panels" FontSize="13" Foreground="#B8C6CC" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{Binding ReduceTransparency, Mode=TwoWay}" OnContent="" OffContent="" Margin="0,-6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{ThemeResource NereaGhostButton}" Click="Rescan_Click" Margin="0,4,0,0"
                            BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10">
                        <TextBlock Text="Rescan library folders" FontSize="13" Foreground="#E8EFF2" />
                    </Button>

                    <TextBlock Text="NEREA" FontFamily="Georgia" FontSize="17" Foreground="#E8EFF2"
                               CharacterSpacing="140" Margin="0,26,0,0" />
                    <TextBlock Text="Let the music create the world." FontSize="12" Foreground="#6E808A" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#4E5E68" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
