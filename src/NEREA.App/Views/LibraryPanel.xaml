<UserControl
    x:Class="NEREA.App.Views.LibraryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsRightTapEnabled="True">

    <Border x:Name="PanelRoot"
            Width="560"
            Background="{ThemeResource NereaAcrylicBrush}"
            BorderBrush="#267FC4C9" BorderThickness="1,0,0,0"
            CornerRadius="18,0,0,18">
        <Grid Padding="26,20,26,16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <TextBlock Text="LIBRARY" Style="{ThemeResource NereaPanelHeaderText}" />
                <Button Style="{ThemeResource NereaGhostButton}" HorizontalAlignment="Right"
                        Click="Close_Click" ToolTipService.ToolTip="Close">
                    <Path Stroke="#E8EFF2" StrokeThickness="1.6" Stretch="None"
                          Data="M 5,5 L 15,15 M 15,5 L 5,15" />
                </Button>
            </Grid>

            <!-- Search + sort -->
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         PlaceholderText="Search title, artist, album…"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         CornerRadius="8" />
                <ComboBox x:Name="SortCombo" Grid.Column="1"
                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                          CornerRadius="8" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Title A–Z" />
                    <ComboBoxItem Content="Recently added" />
                    <ComboBoxItem Content="Duration" />
                    <ComboBoxItem Content="Artist" />
                </ComboBox>
            </Grid>

            <!-- Tabs -->
            <Pivot x:Name="Tabs" Grid.Row="2" Margin="-14,0,-14,0" SelectionChanged="Tabs_SelectionChanged">
                <PivotItem Header="Songs" />
                <PivotItem Header="Albums" />
                <PivotItem Header="Artists" />
                <PivotItem Header="Playlists" />
                <PivotItem Header="Favorites" />
                <PivotItem Header="Recent" />
                <PivotItem Header="Folders" />
                <PivotItem Header="Up Next" />
            </Pivot>

            <!-- Content -->
            <Grid Grid.Row="3">
                <!-- Songs / Favorites / Recent -->
                <ListView x:Name="SongsList"
                          ItemsSource="{Binding Songs, Mode=OneWay}"
                          SelectionMode="Single"
                          IsDoubleTapEnabled="True"
                          IsRightTapEnabled="True"
                          DoubleTapped="SongsList_DoubleTapped"
                          RightTapped="List_RightTapped"
                          Visibility="{Binding SongsVisible, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="44" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#E8EFF2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayArtist}" FontSize="11" Foreground="#8FA0A8"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Duration, Converter={StaticResource TimeToText}}"
                                               FontSize="11" Foreground="#8FA0A8" />
                                    <TextBlock Text="♥" FontSize="12" Foreground="#7FC4C9"
                                               Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Groups: Albums / Artists / Folders -->
                <ListView x:Name="GroupsList"
                          ItemsSource="{Binding Groups, Mode=OneWay}"
                          SelectionMode="Single"
                          IsDoubleTapEnabled="True"
                          IsRightTapEnabled="True"
                          DoubleTapped="GroupsList_DoubleTapped"
                          RightTapped="List_RightTapped"
                          Visibility="{Binding GroupsVisible, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="52" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                      Background="#1E2A36">
                                    <TextBlock Text="♪" FontSize="16" Foreground="#3E5866"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="#E8EFF2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8FA0A8"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Playlists -->
                <StackPanel x:Name="PlaylistsView" Spacing="10"
                            Visibility="{Binding PlaylistsVisible, Mode=OneWay}">
                    <Button Style="{ThemeResource NereaGhostButton}" Click="NewPlaylist_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Stroke="#7FC4C9" StrokeThickness="1.6" Stretch="None"
                                  Data="M 9,4 V 14 M 4,9 H 14" />
                            <TextBlock Text="New playlist" FontSize="13" Foreground="#E8EFF2" />
                        </StackPanel>
                    </Button>
                    <ListView x:Name="PlaylistsList"
                              ItemsSource="{Binding PlaylistList, Mode=OneWay}"
                              SelectionMode="Single"
                              IsDoubleTapEnabled="True"
                              IsRightTapEnabled="True"
                              DoubleTapped="PlaylistsList_DoubleTapped"
                              RightTapped="List_RightTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="44">
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8EFF2" />
                                        <TextBlock Text="{Binding TrackIds.Count}" FontSize="11"
                                                   Foreground="#8FA0A8" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Queue -->
                <ListView x:Name="QueueList"
                          ItemsSource="{Binding Queue, Mode=OneWay}"
                          SelectionMode="Single"
                          IsDoubleTapEnabled="True"
                          IsRightTapEnabled="True"
                          DoubleTapped="QueueList_DoubleTapped"
                          RightTapped="List_RightTapped"
                          Visibility="{Binding QueueVisible, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="44" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#E8EFF2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayArtist}" FontSize="11" Foreground="#8FA0A8" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{ThemeResource NereaGhostButton}"
                                        Click="RemoveFromQueue_Click" ToolTipService.ToolTip="Remove from queue">
                                    <Path Stroke="#8FA0A8" StrokeThickness="1.4" Stretch="None"
                                          Data="M 5,5 L 11,11 M 11,5 L 5,11" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Drill-in: album / artist / folder / playlist tracks -->
                <ListView x:Name="GroupTracksList"
                          ItemsSource="{Binding PlaylistSongs, Mode=OneWay}"
                          SelectionMode="Single"
                          IsDoubleTapEnabled="True"
                          IsRightTapEnabled="True"
                          DoubleTapped="GroupTracksList_DoubleTapped"
                          RightTapped="List_RightTapped"
                          Visibility="{Binding ShowGroupTracks, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                    <ListView.Header>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{ThemeResource NereaGhostButton}" Click="Back_Click" Padding="4">
                                    <Path Stroke="#E8EFF2" StrokeThickness="1.6" Stretch="None"
                                          Data="M 12,4 L 6,10 L 12,16" />
                                </Button>
                                <TextBlock Text="{Binding GroupTracksTitle}" FontSize="16"
                                           Foreground="#E8EFF2" VerticalAlignment="Center"
                                           FontFamily="Georgia" />
                                <Button Style="{ThemeResource NereaGhostButton}" Click="PlayGroupTracks_Click"
                                        ToolTipService.ToolTip="Play all">
                                    <Path Fill="#E8EFF2" Stretch="None" Data="M 6,4 L 17,10 L 6,16 Z" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="42" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#E8EFF2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayArtist}" FontSize="11" Foreground="#8FA0A8" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Duration, Converter={StaticResource TimeToText}}"
                                           FontSize="11" Foreground="#8FA0A8" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{Binding HasLibrary, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="No music yet" FontFamily="Georgia" FontSize="16"
                               Foreground="#9AAAB2" HorizontalAlignment="Center" />
                    <TextBlock Text="Add files or a folder below, or drop them onto the window."
                               FontSize="12" Foreground="#6E808A" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Import actions -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                <Button Style="{ThemeResource NereaGhostButton}" Click="AddFiles_Click"
                        BorderBrush="#337FC4C9" BorderThickness="1" CornerRadius="10">
                    <TextBlock Text="Add files" FontSize="13" Foreground="#E8EFF2" />
                </Button>
                <Button Style="{ThemeResource NereaGhostButton}" Click="AddFolder_Click"
                        BorderBrush="#337FC4C9" BorderThickness="1" CornerRadius="10">
                    <TextBlock Text="Add folder" FontSize="13" Foreground="#E8EFF2" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
