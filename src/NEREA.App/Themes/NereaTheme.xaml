<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:NEREA.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:TimeSpanToStringConverter x:Key="TimeToText" />
    <conv:CollectionCountToVisibilityConverter x:Key="ColToVis" />
    <conv:HexToBrushConverter x:Key="HexBrush" />

    <!-- NEREA palette: deep aquatic dark, restrained accents. -->
    <Color x:Key="NereaDeep">#0A1420</Color>
    <Color x:Key="NereaPanel">#141B24</Color>
    <Color x:Key="NereaAqua">#7FC4C9</Color>
    <Color x:Key="NereaMist">#E8EFF2</Color>

    <SolidColorBrush x:Key="NereaTextBrush" Color="#E8EFF2" />
    <SolidColorBrush x:Key="NereaTextDimBrush" Color="#9AAAB2" />
    <SolidColorBrush x:Key="NereaAquaBrush" Color="#7FC4C9" />
    <SolidColorBrush x:Key="NereaPanelBrush" Color="#141B24" />

    <AcrylicBrush x:Key="NereaAcrylicBrush"
                  TintColor="#141B24"
                  TintOpacity="0.72"
                  FallbackColor="#141B24" />
    <AcrylicBrush x:Key="NereaAcrylicSoftBrush"
                  TintColor="#10161E"
                  TintOpacity="0.6"
                  FallbackColor="#10161E" />

    <!-- Ghost icon button: the only control style the immersive layer uses. -->
    <Style x:Key="NereaGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Foreground" Value="#E8EFF2" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="NereaGhostToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Foreground" Value="#9AAAB2" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="NereaPanelHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="#E8EFF2" />
        <Setter Property="CharacterSpacing" Value="30" />
    </Style>

    <Style x:Key="NereaSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#7FC4C9" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Margin" Value="0,18,0,6" />
    </Style>

    <LinearGradientBrush x:Key="NereaFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1826" Offset="0.0" />
        <GradientStop Color="#103648" Offset="0.55" />
        <GradientStop Color="#0A1420" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NereaSeekFillBrush" Color="#7FC4C9" />
</ResourceDictionary>
